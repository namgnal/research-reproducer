  "title": "缩放点积注意力的局部机制复现",
  "question": "在独立、零均值、单位方差的随机 Q/K 输入下，除以 sqrt(d_k) 是否符合论文公式，并使 logits 方差在不同维度下保持接近 1？",
  "reproduction_level": "mechanism",
  "scope": "仅验证 Attention Is All You Need 第 3.2.1 节公式 (1) 与脚注 4 的随机输入机制。未训练 Transformer，未使用 WMT 数据，未验证 BLEU。阈值是本实验的操作化条件。",
  "files": ["attention.py", "evaluate.py", "config.json"],
  "protected_files": ["evaluate.py"],
  "command": ["{python}", "evaluate.py", "--seed", "{seed}", "--phase", "{phase}", "--output", "{result}"],
  "seeds": [11, 23, 37, 53, 71],
